# Credentials for the platform-wide HTTP Basic auth guard (lib/basic-auth).
# Both must be set or every service answers 503 (fail closed).
PLATFORM_AUTH_USERNAME=admin
PLATFORM_AUTH_PASSWORD=Potential

# Only needed by @workspace/api-server and @workspace/db.
# The FAHR platform mockup is front-end only and does not use it.
# DATABASE_URL=postgres://user:password@localhost:5432/fahr

# --- Deployment (docker-compose.yml / Dokploy) -------------------------

# Public base path the platform is served from. Baked into the bundle at build
# time as import.meta.env.BASE_URL, so changing it requires a rebuild, not a
# restart. Leave at "/" for a normal domain.
BASE_PATH=/
