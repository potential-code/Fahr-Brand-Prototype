# Build context exclusions. Keep this in sync with .gitignore — anything the
# image needs must NOT be listed here.

# Installed by pnpm inside the image, never copied in.
node_modules
**/node_modules

# Build output — regenerated by the builder stage.
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets. Every value reaches the container through the environment instead.
.env
.env.*
!.env.example

# The `@assets` Vite alias points at attached_assets/ but nothing in
# artifacts/fahr-platform/src imports through it, so the 34 MB of source
# material stays out of the build context. If a component ever does
# `import ... from "@assets/..."`, delete this line or the build will fail
# with an unresolved import.
attached_assets

# Not needed to build or run.
.git
.gitignore
.replit
.replitignore
.agents
.cache
.local
.vscode
.idea
*.log
replit.md
